---
import Layout from '../layouts/Layout.astro';
import ExternalLink from '../components/ExternalLink.astro';
import ToolDiagram from '../components/ToolDiagram.astro';
import HeroBonsai from '../components/HeroBonsai.astro';
import bonsai from '../assets/bonsai.svg?raw';
import { indicators, TV_PROFILE } from '../data/indicators';

const ways = [
  { cls: 'grow', kanji: '育', word: 'Grow', romaji: 'sodateru', saying: 'Nothing grows by being pulled.' },
  { cls: 'cut', kanji: '切', word: 'Cut', romaji: 'kiru', saying: 'The cut that keeps the tree.' },
  { cls: 'wait', kanji: '待', word: 'Wait', romaji: 'matsu', saying: 'Stillness is part of the work.' },
];
---

<Layout bodyClass="p-home">
  <section class="hero">
    <div class="wrap">
      <p class="intro">Free indicators for TradingView</p>
      <h1>
        <span class="l l1">Grow with patience. </span><span class="cutline" aria-hidden="true"
          ><span class="hero-tree"><HeroBonsai /></span><span class="cut-note"></span></span
        ><span class="l l2">Cut with discipline.</span>
      </h1>
      <p class="lede">Pine Script indicators built on written rules. Free to use, and most are open to read.</p>
      <div class="actions">
        <a class="btn btn-primary" href="/tools">Browse tools</a>
        <ExternalLink class="btn btn-ghost" href={TV_PROFILE}>Follow on TradingView</ExternalLink>
      </div>
    </div>
  </section>

  <section class="ways" aria-labelledby="ways-title">
    <div class="wrap">
      <h2 id="ways-title">Let what works grow, cut what doesn’t, and give it time.</h2>
      <div class="ways-grid">
        {
          ways.map((w) => (
            <div class={`way ${w.cls}`}>
              <span class="kanji" lang="ja">{w.kanji}</span>
              <p class="word">{w.word}<i>{w.romaji}</i></p>
              <p class="saying">{w.saying}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="tools" aria-labelledby="tools-title">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="tools-title"><small>{indicators.length} public tools</small>Indicators</h2>
        <p>Free on TradingView. The open-source ones let you read every line of the Pine Script.</p>
        <a class="text-link" href="/tools">See all tools</a>
      </div>
      <div class="tile-grid">
        {
          indicators.map((t) => (
            <a class="tile" href={`/tools/${t.slug}`} aria-labelledby={`tile-${t.slug}`} aria-describedby={`tile-${t.slug}-d`}>
              <div class="tile-fig">
                <ToolDiagram slug={t.slug} />
              </div>
              <div class="tile-meta">
                <span class="cat">{t.category}</span>
                <span class="lic">{t.access}</span>
              </div>
              <h3 id={`tile-${t.slug}`}>{t.name}</h3>
              <p id={`tile-${t.slug}-d`}>{t.summary}</p>
              <span class="more">View tool</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="philo" aria-labelledby="philo-title">
    <div class="wrap philo-grid">
      <div class="philo-art"><Fragment set:html={bonsai} /></div>
      <div>
        <h2 id="philo-title">A bonsai is not made in a day.</h2>
        <p class="body">
          It is grown with patience and shaped by careful cuts. Trading is the same: let what works grow, cut what
          doesn’t, and give it time.
        </p>
        <ul class="practice">
          <li><span><b>Written rules.</b> Every tool follows rules set down before the chart moves.</span></li>
          <li><span><b>The same levels, every time.</b> Your plan is on the chart before the trade.</span></li>
          <li><span><b>Describes, never predicts.</b> Readings are context for your own analysis.</span></li>
        </ul>
        <blockquote>
          <img src="/kiko.svg" width="79" height="132" loading="lazy" alt="" />
          <div>
            <p>Wealth is grown, not grabbed.</p>
            <small>A way of thinking, not a promise of returns.</small>
          </div>
        </blockquote>
      </div>
    </div>
  </section>
</Layout>
