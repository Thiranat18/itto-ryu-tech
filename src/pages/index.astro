---
import Layout from '../layouts/Layout.astro';
import LessonCard from '../components/LessonCard.astro';
import { lessons } from '../data/lessons';

const principles = [
  {
    kanji: '型',
    name: 'ระบบ',
    text: 'ทุกการตัดสินใจมีกติกาที่เขียนลงไปได้ ถ้าอธิบายเป็นกติกาไม่ได้ ก็ทดสอบไม่ได้',
  },
  {
    kanji: '律',
    name: 'วินัย',
    text: 'วางแผนก่อนเข้า รู้จุดตัดขาดทุนก่อนกดส่งคำสั่ง และทำตามแผนแม้ไม่อยากทำ',
  },
  {
    kanji: '証',
    name: 'หลักฐาน',
    text: 'เชื่อสัญญาณเมื่อข้อมูลยืนยัน และเปิดผลที่ไม่ผ่านให้ดูด้วยเสมอ',
  },
];
---

<Layout>
  <section class="mx-auto max-w-5xl px-4 sm:px-6 pt-16 sm:pt-24 pb-16">
    <p class="text-shu text-sm font-medium tracking-widest">一刀流 · ITTO-RYU</p>
    <h1 class="mt-4 font-serif text-4xl sm:text-6xl font-bold leading-tight">
      ฝึกเทรด<br class="sm:hidden" />อย่างนักดาบ
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-muted leading-relaxed">
      สำนักฝึกเทรดแบบ open-source เรียนผ่าน indicator ของ Itto-ryu บน TradingView
      ดูกราฟจริง ตอบคำถาม "เข้าหรือไม่เข้า?" และเห็นทั้งผลทดสอบที่ผ่านและที่ไม่ผ่าน
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/lessons" class="rounded-md bg-shu px-5 py-3 font-medium text-ink hover:brightness-110">ดูหลักสูตร</a>
      <a href="/about" class="rounded-md border border-line px-5 py-3 hover:bg-ink-2">ทำไมต้องสำนักนี้</a>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 sm:px-6 py-12 border-t border-line">
    <h2 class="font-serif text-2xl font-semibold">หลักสามข้อของสำนัก</h2>
    <div class="mt-8 grid gap-6 sm:grid-cols-3">
      {principles.map((p) => (
        <div>
          <div class="font-serif text-4xl text-shu">{p.kanji}</div>
          <h3 class="mt-2 text-lg font-semibold">{p.name}</h3>
          <p class="mt-1 text-sm text-muted leading-relaxed">{p.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 sm:px-6 py-12 border-t border-line">
    <div class="flex items-end justify-between gap-4">
      <div>
        <h2 class="font-serif text-2xl font-semibold">เส้นทาง Kyu → Dan</h2>
        <p class="mt-1 text-sm text-muted">ผ่านครบสี่บทเพื่อรับสายดำขั้นแรก (Shodan)</p>
      </div>
      <a href="/lessons" class="text-sm text-muted underline hover:text-paper shrink-0">ทั้งหมด</a>
    </div>
    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      {lessons.map((lesson, i) => <LessonCard lesson={lesson} index={i} />)}
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 sm:px-6 py-12 border-t border-line">
    <h2 class="font-serif text-2xl font-semibold">ทุกบทเรียนมีอะไร</h2>
    <ol class="mt-6 grid gap-4 sm:grid-cols-4 text-sm">
      <li class="rounded-lg border border-line p-4"><span class="text-shu font-semibold">1.</span> แนวคิดสั้น ๆ อ่านจบในราว 3 นาที</li>
      <li class="rounded-lg border border-line p-4"><span class="text-shu font-semibold">2.</span> กราฟ interactive แสดงสัญญาณ</li>
      <li class="rounded-lg border border-line p-4"><span class="text-shu font-semibold">3.</span> Quiz "เข้าหรือไม่เข้า?" จากกราฟที่ซ่อนชื่อและวันที่</li>
      <li class="rounded-lg border border-line p-4"><span class="text-shu font-semibold">4.</span> ลิงก์ไป indicator ตัวจริงบน TradingView</li>
    </ol>
  </section>
</Layout>
