---
import Layout from '../layouts/Layout.astro';
import ExternalLink from '../components/ExternalLink.astro';
import singleCut from '../assets/single-cut.svg?raw';
import { TV_PROFILE } from '../data/indicators';
import { OWNER, OWNER_DISPLAY } from '../data/owner';
---

<Layout title="About" description="Itto-Ryu Tech: free Pine Script indicators, grown with patience." bodyClass="p-about">
  <section class="about-hero">
    <div class="wrap">
      <div class="about-tate" aria-hidden="true"><span lang="ja">明鏡止水</span><small>meikyō shisui, a clear mirror, still water</small></div>
      <p class="crumb">About</p>
      <h1>A bonsai is not made{' '}<br />in a day.</h1>
      <p class="sub">It is grown with patience and shaped by careful cuts. Trading is the same.</p>
    </div>
  </section>

  <section class="name" aria-labelledby="name-title">
    <div class="wrap name-grid">
      <div>
        <h2 id="name-title"><span lang="ja">一刀</span>, a single cut</h2>
        <p>
          The name borrows <span lang="ja">一刀</span> (ittō), Japanese for “a single cut”. Here it means the one
          deliberate cut a gardener makes when shaping a tree.
        </p>
        <p>
          The guiding phrase <span lang="ja">明鏡止水</span> (<i lang="ja-Latn">meikyō shisui</i>, “a clear mirror, still
          water”) is a reminder that a still mind reads the chart more clearly.
        </p>
        <p class="quiet">
          Itto-Ryu Tech is not affiliated with any Ittō-ryū school of swordsmanship, and is not affiliated with or
          endorsed by TradingView.
        </p>
      </div>
      <div><Fragment set:html={singleCut} /></div>
    </div>
  </section>

  <section class="owner" aria-labelledby="author">
    <div class="wrap owner-grid">
      <div><h2 id="author">Owner and developer</h2></div>
      <div>
        <p class="who">{OWNER_DISPLAY}</p>
        <p class="role">{OWNER.role}</p>
        <p>
          Itto-Ryu Tech is a one-person practice by {OWNER_DISPLAY}, a trader who writes Pine Script indicators, most
          of them open-source, and publishes them free on{' '}
          <ExternalLink class="text-link" href={TV_PROFILE}>TradingView</ExternalLink>.
        </p>
        <p>
          Owns and develops Itto-Ryu Tech: the indicators, this website and its code. On TradingView as{' '}
          <ExternalLink class="text-link" href={TV_PROFILE}>Thiranat</ExternalLink>.
        </p>
        <div class="disc">
          <b>For education only. Not investment advice.</b> Indicators describe market conditions; they do not predict
          prices. <a class="text-link" href="/disclaimer">Read the full disclaimer</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
