---
import Layout from '../../../layouts/Layout.astro';
import ReportReel from '../../../components/ReportReel.astro';
import { skillsIn } from '../../../data/skills';
import { LANGS, fill, langOf, langParam, localize, t } from '../../../i18n';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang: langParam(lang) } }));
}

const lang = langOf(Astro.url.pathname);
const copy = t(lang).aiLab;
const skills = skillsIn(lang);
const pad = (n: number) => String(n).padStart(2, '0');
---

<Layout title={copy.title} description={copy.description} bodyClass="p-ai-lab">
  <header class="tile tile-fill tile-big span-3 page-title">
    <p class="crumb">{copy.crumb}</p>
    <h1>{copy.h1}</h1>
    <span class="cut" aria-hidden="true"></span>
    <p class="lede">{copy.lede}</p>
  </header>
  <div class="tile tile-ink count">
    <span class="count-n" aria-hidden="true">{pad(skills.length)}</span>
    <p>{skills.length} {skills.length === 1 ? copy.count : copy.countMany}</p>
  </div>

  <ul class="skill-rows">
    {
      skills.map((s) => (
        <li class="tile tile-fill skill-card">
          <div class="skill-fig">
            <ReportReel slides={s.reel} />
          </div>
          <div class="skill-card-body">
            <div class="meta">
              <span class="cat">{s.kind}</span>
              <span class="lic">{copy.free}</span>
              <span class="lic">{fill(copy.version, { v: s.version })}</span>
            </div>
            <h2><a href={localize(lang, `/ai-lab/${s.slug}`)}>{s.name}</a></h2>
            <p>{s.summary}</p>
            <p class="skill-state">{s.stateOnly}</p>
            <div class="row-act">
              <a class="btn btn-primary" href={localize(lang, `/ai-lab/${s.slug}`)}>{copy.view}<span class="sr-only">: {s.name}</span></a>
              <a class="text-link" href={s.zip.href} download data-event="skill_download" data-skill={s.slug}>{copy.download}</a>
            </div>
          </div>
        </li>
      ))
    }
  </ul>

  <div class="tile tile-line span-2 note">
    <h2>{copy.whatTitle}</h2>
    <p>{copy.whatText}</p>
  </div>
  <div class="tile tile-line span-2 note">
    <h2>{copy.ruleTitle}</h2>
    <p>{copy.ruleText}</p>
  </div>
  <script>
    for (const el of document.querySelectorAll<HTMLElement>('[data-event]')) {
      el.addEventListener('click', () => {
        const { event, ...data } = el.dataset;
        (window as { va?: (type: string, payload: object) => void }).va?.('event', { name: event, data });
      });
    }
  </script>
</Layout>
