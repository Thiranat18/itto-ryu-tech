---
import Layout from '../../layouts/Layout.astro';
import ExternalLink from '../../components/ExternalLink.astro';
import Phrases from '../../components/Phrases.astro';
import { TV_PROFILE } from '../../data/indicators';
import { OWNER_DISPLAY } from '../../data/owner';
import { LANGS, fill, langOf, langParam, localize, t } from '../../i18n';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang: langParam(lang) } }));
}

const lang = langOf(Astro.url.pathname);
const ui = t(lang);
const copy = ui.about;
---

<Layout title={copy.title} description={copy.description} bodyClass="p-about">
  <header class="tile tile-fill tile-big span-3 about-title">
    <p class="crumb">{copy.crumb}</p>
    <h1 class="title-h1" set:html={copy.h1Html} />
    <span class="cut" aria-hidden="true"></span>
    <p class="sub"><Phrases text={copy.sub} /></p>
  </header>
  <div class="tile tile-ink tate-tile" aria-hidden="true">
    <span class="about-tate" lang="ja">明鏡止水</span>
    <span class="about-tate-gloss">{copy.tateGloss}</span>
  </div>

  <div class="tile tile-line span-2 name-head">
    <h2 id="name-title" set:html={copy.nameTitleHtml} />
  </div>
  <div class="tile tile-fill span-2 name-body">
    <p set:html={copy.name1Html} />
    <p set:html={copy.name2Html} />
    <p class="quiet">{copy.name3}</p>
  </div>

  <div class="tile tile-fill span-2 kiko-art">
    <img src="/kiko-scene.svg" width="343" height="340" loading="lazy" alt={copy.kikoAlt} />
  </div>
  <section class="tile tile-line span-2 kiko-copy" aria-labelledby="kiko-title">
    <p class="eyebrow" set:html={copy.kikoEyebrowHtml} />
    <h2 id="kiko-title"><Phrases text={copy.kikoTitle} /></h2>
    <p class="body">{copy.kikoBody}</p>
  </section>

  <section class="tile tile-line span-4 owner-tile" aria-labelledby="author">
    <h2 id="author">{copy.ownerTitle}</h2>
    <div>
      <p class="who">{OWNER_DISPLAY}</p>
      <p class="role">{ui.site.ownerRole}</p>
      <p>
        {fill(copy.owner1Before, { owner: OWNER_DISPLAY })}<ExternalLink class="text-link" href={TV_PROFILE}
          >TradingView</ExternalLink
        >{copy.owner1After}
      </p>
      <p>
        {copy.owner2Before}<ExternalLink class="text-link" href={TV_PROFILE}>ITTO-RYU</ExternalLink>{copy.owner2After}
      </p>
      <div class="disc">
        <b>{copy.discBold}</b>{' '}
        {copy.discText} <a class="text-link" href={localize(lang, '/disclaimer')}>{copy.discLink}</a>
      </div>
    </div>
  </section>
</Layout>
