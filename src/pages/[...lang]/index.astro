---
// Home as a six-chapter scroll story: 序 Open · 道 Ways · 智 AI-Lab · 具 Tools · 心 Practice · 結 Close.
// The HTML is the finished page; src/scripts/scrolly.ts animates it when GSAP has loaded and motion is allowed.
import Layout from '../../layouts/Layout.astro';
import ExternalLink from '../../components/ExternalLink.astro';
import ToolDiagram from '../../components/ToolDiagram.astro';
import Phrases from '../../components/Phrases.astro';
import ReportReel from '../../components/ReportReel.astro';
import bonsai from '../../assets/bonsai.svg?raw';
import bonsaiScroll from '../../assets/bonsai-scroll.svg?raw';
import brushGrow from '../../assets/kanji/brush-grow.svg?raw';
import brushCut from '../../assets/kanji/brush-cut.svg?raw';
import brushWait from '../../assets/kanji/brush-wait.svg?raw';
import { indicatorsIn, TV_PROFILE } from '../../data/indicators';
import { skillsIn } from '../../data/skills';
import { LANGS, fill, label, langOf, langParam, localize, t } from '../../i18n';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang: langParam(lang) } }));
}

const lang = langOf(Astro.url.pathname);
const ui = t(lang);
const copy = ui.home;
const indicators = indicatorsIn(lang);
const ways = [
  { id: 'grow', romaji: 'sodateru', svg: brushGrow },
  { id: 'cut', romaji: 'kiru', svg: brushCut },
  { id: 'wait', romaji: 'matsu', svg: brushWait },
].map((w, i) => ({ ...w, ...copy.ways[i] }));
const skill = skillsIn(lang)[0];
// The terminal in 智 AI-Lab types the command one character at a time.
const typed = [...skill.reel[0].command];
const chapters = ['序', '道', '智', '具', '心', '結'].map((kanji, i) => ({ kanji, label: copy.chapters[i] }));
const pad = (n: number) => String(n).padStart(2, '0');
---

<Layout bodyClass="p-home">
  <div class="story-rail" slot="rail" aria-hidden="true">
    <div class="story-track"><i class="story-ink"></i></div>
    <ol class="story-chapters">
      {
        chapters.map((c) => (
          <li>
            <span class="ch-k" lang="ja">{c.kanji}</span>
            <span class="ch-l">{c.label}</span>
          </li>
        ))
      }
    </ol>
  </div>

  <!-- 1 · 序 Open: the bonsai grows, one cut -->
  <section class="chapter ch-open" aria-labelledby="hero-title" data-chapter="open">
    <div class="tile tile-fill hero">
      <p class="intro">{copy.intro}</p>
      <h1 id="hero-title">
        <span class="l l1">{copy.heroLine1} </span><span class="cut" aria-hidden="true"></span><span class="l l2"
          >{copy.heroLine2}</span
        >
      </h1>
      <div class="hero-foot">
        <p class="lede">{copy.lede}</p>
        <div class="actions">
          <a class="btn btn-primary" href={localize(lang, '/tools')}>{copy.browse}</a>
          <ExternalLink class="btn btn-ghost" href={TV_PROFILE}>{copy.follow}</ExternalLink>
        </div>
      </div>
      <p class="scroll-hint" aria-hidden="true">{copy.scrollHint}</p>
    </div>
    <div class="tile tile-fill bonsai-tile"><Fragment set:html={bonsaiScroll} /></div>
  </section>

  <!-- 2 · 道 Ways: the brush writes 育 → 切 → 待 (stroke order: KanjiVG, CC BY-SA 3.0) -->
  <section class="chapter ch-ways" aria-labelledby="ways-title" data-chapter="ways">
    <h2 id="ways-title" class="ways-title"><Phrases text={copy.waysTitle} /></h2>
    <div class="ways-row">
      {
        ways.map((w) => (
          <div class={`tile tile-line way way-${w.id}`}>
            <Fragment set:html={w.svg} />
            <div class="way-text">
              <p class="word">
                {w.word} <i lang="ja-Latn">{w.romaji}</i>
              </p>
              <p class="saying">
                <Phrases text={w.saying} />
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- 3 · 智 AI-Lab: the command types itself, then a real report answers -->
  <section class="chapter ch-lab" aria-labelledby="lab-title" data-chapter="lab">
    <div class="tools-head lab-head">
      <h2 id="lab-title"><small>{copy.labKicker}</small>AI-Lab</h2>
      <p>{copy.labLede}</p>
    </div>
    <div class="lab-pair">
      <div class="tile tile-ink lab-term" lang="en">
        <div class="term-bar" aria-hidden="true"><i></i><i></i><i></i><span>Claude</span></div>
        <p class="term-cmd" aria-hidden="true">
          <span class="term-p">›</span>
          <span class="term-type">{typed.map((ch) => <span class="ch">{ch}</span>)}</span><span class="term-caret"></span>
        </p>
        <ReportReel slides={skill.reel} commandTarget=".ch-lab .term-type" />
        <span class="term-mark" lang="ja" aria-hidden="true">智</span>
      </div>
      <div class="tile tile-fill lab-copy">
        <h3><Phrases text={copy.labTitle} /></h3>
        <p class="lab-text">{copy.labText}</p>
        <ol class="lab-steps">
          {
            copy.labSteps.map((step) => (
              <li>
                <b>{step.b}</b> {step.text}
              </li>
            ))
          }
        </ol>
        <div class="actions">
          <a class="btn btn-primary" href={localize(lang, '/ai-lab')}>{copy.labCta}</a>
          <a class="text-link" href={skill.zip.href} download>{copy.labDownload}</a>
        </div>
        <p class="lab-note">{copy.labNote}</p>
      </div>
    </div>
  </section>

  <!-- 4 · 具 Tools: unrolled like a handscroll -->
  <section class="chapter ch-tools" aria-labelledby="tools-title" data-chapter="tools">
    <div class="tools-head">
      <h2 id="tools-title"><small>{fill(copy.toolsCount, { n: indicators.length })}</small>{copy.toolsTitle}</h2>
      <p>{copy.toolsText}</p>
      <span class="counter" aria-hidden="true" data-counter data-format={copy.counter} data-total={pad(indicators.length)}
        >{fill(copy.counter, { n: pad(1), total: pad(indicators.length) })}</span
      >
    </div>
    <div class="track-view">
      <div class="track">
        <div class="tile tile-ink ink-tools">
          <span class="ink-k" lang="ja" aria-hidden="true">具</span>
          <div>
            <p class="ink-title" set:html={copy.inkTitleHtml} />
            <p class="unroll-hint" aria-hidden="true">{copy.unrollHint}</p>
          </div>
          <a class="text-link" href={localize(lang, '/tools')}>{copy.seeAll}</a>
        </div>
        {
          indicators.map((tool, i) => (
            <a
              class="tile tile-fill tool-tile"
              href={localize(lang, `/tools/${tool.slug}`)}
              aria-labelledby={`tile-${tool.slug}`}
              aria-describedby={`tile-${tool.slug}-d`}
            >
              <div class="tool-fig" lang="en">
                <ToolDiagram slug={tool.slug} />
              </div>
              <div class="meta">
                <span class="tool-n" aria-hidden="true">
                  {pad(i + 1)}
                </span>
                <span class="cat">{label(lang, 'categories', tool.category)}</span>
                <span class="lic">{label(lang, 'access', tool.access)}</span>
              </div>
              <h3 id={`tile-${tool.slug}`}>{tool.name}</h3>
              <p id={`tile-${tool.slug}-d`}>{tool.summary}</p>
              <span class="more" aria-hidden="true">
                {copy.viewTool}
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 5 · 心 Practice -->
  <section class="chapter ch-prac" aria-labelledby="philo-title" data-chapter="practice">
    <div class="tile tile-fill philo-art" lang="en"><Fragment set:html={bonsai} /></div>
    <div class="tile tile-line philo">
      <h2 id="philo-title"><Phrases text={copy.philoTitle} /></h2>
      <p class="body">{copy.philoBody}</p>
      <ul class="practice">
        {
          copy.practice.map((p) => (
            <li>
              <span class="dash-mark" aria-hidden="true" />
              <span>
                <b>{p.b}</b> {p.text}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 6 · 結 Close -->
  <div class="chapter ch-close" data-chapter="close">
    <figure class="tile tile-line close-tile">
      <img class="close-kiko" src="/kiko.svg" width="178" height="300" loading="lazy" alt="" />
      <div class="close-words">
        <blockquote><p class="quote-text"><Phrases text={copy.quote} /></p></blockquote>
        <p class="quote-note">{copy.quoteNote}</p>
      </div>
      <p class="close-tate" lang="ja" aria-hidden="true"><span>明</span><span>鏡</span><span>止</span><span>水</span></p>
    </figure>
  </div>

  <script>
    import '../../scripts/scrolly';
  </script>
</Layout>
