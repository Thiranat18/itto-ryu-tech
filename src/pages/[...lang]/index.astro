---
import Layout from '../../layouts/Layout.astro';
import ExternalLink from '../../components/ExternalLink.astro';
import ToolDiagram from '../../components/ToolDiagram.astro';
import Phrases from '../../components/Phrases.astro';
import bonsai from '../../assets/bonsai.svg?raw';
import { FULL_MARK } from '../../components/marks';
import { indicatorsIn, TV_PROFILE } from '../../data/indicators';
import { LANGS, fill, label, langOf, langParam, localize, t } from '../../i18n';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang: langParam(lang) } }));
}

const lang = langOf(Astro.url.pathname);
const ui = t(lang);
const copy = ui.home;
const indicators = indicatorsIn(lang);
const ways = [
  { cls: 'k-grow', kanji: '育', romaji: 'sodateru' },
  { cls: 'k-cut', kanji: '切', romaji: 'kiru' },
  { cls: 'k-wait', kanji: '待', romaji: 'matsu' },
].map((w, i) => ({ ...w, ...copy.ways[i] }));
---

<Layout bodyClass="p-home">
  <section class="tile tile-fill tile-big hero" aria-labelledby="hero-title">
    <p class="intro">{copy.intro}</p>
    <h1 id="hero-title">
      <span class="l l1">{copy.heroLine1} </span><span class="cut" aria-hidden="true"></span><span class="l l2"
        >{copy.heroLine2}</span
      >
    </h1>
    <div class="hero-foot">
      <p class="lede">{copy.lede}</p>
      <div class="actions">
        <a class="btn btn-primary" href={localize(lang, '/tools')}>{copy.browse}</a>
        <ExternalLink class="btn btn-ghost" href={TV_PROFILE}>{copy.follow}</ExternalLink>
      </div>
    </div>
  </section>
  <div class="tile tile-fill niwa" aria-hidden="true">
    <svg viewBox="0 0 100 100" focusable="false"><g set:html={FULL_MARK} /></svg>
  </div>

  <h2 class="sr-only">{copy.waysTitle}</h2>
  {
    ways.map((w) => (
      <div class="tile tile-line way">
        <span class={`kanji ${w.cls}`} lang="ja">{w.kanji}</span>
        <div>
          <p class="word">{w.word} <i lang="ja-Latn">{w.romaji}</i></p>
          <p class="saying"><Phrases text={w.saying} /></p>
        </div>
      </div>
    ))
  }
  <div class="tile tile-ink ink-tools">
    <p class="ink-label">{fill(copy.toolsCount, { n: indicators.length })}</p>
    <h2 id="tools-title" class="ink-title" set:html={copy.inkTitleHtml} />
    <a class="text-link" href={localize(lang, '/tools')}>{copy.seeAll}</a>
  </div>

  {
    indicators.map((t) => (
      <a
        class="tile tile-fill tool-tile"
        href={localize(lang, `/tools/${t.slug}`)}
        aria-labelledby={`tile-${t.slug}`}
        aria-describedby={`tile-${t.slug}-d`}
      >
        <div class="tool-fig" lang="en">
          <ToolDiagram slug={t.slug} />
        </div>
        <div>
          <div class="meta">
            <span class="cat">{label(lang, 'categories', t.category)}</span>
            <span class="lic">{label(lang, 'access', t.access)}</span>
          </div>
          <h3 id={`tile-${t.slug}`}>{t.name}</h3>
          <p id={`tile-${t.slug}-d`}>{t.summary}</p>
        </div>
      </a>
    ))
  }

  <div class="tile tile-fill philo-art" lang="en"><Fragment set:html={bonsai} /></div>
  <section class="tile tile-line philo" aria-labelledby="philo-title">
    <h2 id="philo-title"><Phrases text={copy.philoTitle} /></h2>
    <p class="body">{copy.philoBody}</p>
    <ul class="dash practice">
      {copy.practice.map((p) => <li><b>{p.b}</b> {p.text}</li>)}
    </ul>
  </section>

  <figure class="tile tile-line quote">
    <img src="/kiko-scene.svg" width="182" height="180" loading="lazy" alt="" />
    <div>
      <blockquote><p><Phrases text={copy.quote} /></p></blockquote>
      <small>{copy.quoteNote}</small>
    </div>
  </figure>
</Layout>
