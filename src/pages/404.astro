---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found">
  <section class="mx-auto max-w-3xl px-4 sm:px-6 pt-24 text-center">
    <p class="font-brush text-6xl text-shu">迷</p>
    <h1 class="mt-4 font-serif text-3xl font-bold">Page not found</h1>
    <p class="mt-2 text-muted">This page may have moved, or it has not been written yet.</p>
    <a href="/" class="mt-8 inline-block rounded-sm border border-line px-5 py-3 hover:bg-ink-2">Back to home</a>
  </section>
</Layout>
