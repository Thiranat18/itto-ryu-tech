---
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';
---

<Layout title="Page not found">
  <section class="mx-auto max-w-3xl px-4 sm:px-6 pt-24 text-center">
    <Logo class="mx-auto size-24" />
    <h1 class="mt-6 font-serif text-3xl font-medium">Page not found</h1>
    <p class="mt-2 text-usu">This branch has been pruned, or it has not grown yet.</p>
    <a href="/" class="mt-8 inline-block rounded border border-ishi px-5 py-3 hover:border-sumi">Back to home</a>
  </section>
</Layout>
