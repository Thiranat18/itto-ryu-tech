---
import Layout from '../../layouts/Layout.astro';
import IndicatorCard from '../../components/IndicatorCard.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import { indicators } from '../../data/indicators';
---

<Layout title="Tools" description="Free Pine Script indicators by Itto-Ryu Tech on TradingView, most of them open-source.">
  <section class="mx-auto max-w-5xl px-4 sm:px-6 pt-16">
    <SectionLabel
      level={1}
      label="Tools"
      title="Indicators"
      subtitle="Free on TradingView. The open-source ones let you read every line of the Pine Script."
    />
    <div class="mt-10 grid gap-4 sm:grid-cols-2">
      {indicators.map((indicator) => <IndicatorCard indicator={indicator} />)}
    </div>
  </section>
</Layout>
