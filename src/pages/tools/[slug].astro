---
import Layout from '../../layouts/Layout.astro';
import ExternalLink from '../../components/ExternalLink.astro';
import { indicators } from '../../data/indicators';

export function getStaticPaths() {
  return indicators.map((indicator) => ({ params: { slug: indicator.slug }, props: { indicator } }));
}

const { indicator } = Astro.props;
const others = indicators.filter((t) => t.slug !== indicator.slug).slice(0, 3);
---

<Layout title={indicator.name} description={indicator.summary} image={indicator.image} bodyClass="p-tools">
  <div class="wrap">
    <div class="detail">
      <article>
        <a class="back" href="/tools">All tools</a>
        <div class="meta">
          <span class="cat">{indicator.category}</span>
          <span class="lic">{indicator.access}</span>
        </div>
        <h1>{indicator.name}</h1>
        <p class="lede">{indicator.summary}</p>
        <ExternalLink class="btn btn-primary m-only" href={indicator.url}>Open on TradingView</ExternalLink>

        <figure class="figure">
          <img
            src={indicator.image}
            width={indicator.imageWidth}
            height={indicator.imageHeight}
            alt={`${indicator.name} readings on an example TradingView chart (illustrative only)`}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <figcaption>
            Illustrative chart. It shows how the tool displays its readings, not a trade idea or recommendation.
          </figcaption>
        </figure>

        <div class="cols">
          <section>
            <h2>How it works</h2>
            <p>{indicator.howItWorks}</p>
          </section>
          <section>
            <h2>How to use</h2>
            <p>{indicator.howToUse}</p>
          </section>
        </div>
      </article>

      <aside class="aside" aria-label="On TradingView">
        <div class="aside-card">
          <ExternalLink class="btn btn-primary" href={indicator.url}>Open on TradingView</ExternalLink>
          <p class="listed">Listed on TradingView as “{indicator.tvTitle}”.</p>
          {
            indicator.legend && (
              <>
                <hr />
                <h2>What it draws</h2>
                <ul class="legend">
                  {indicator.legend.map((item) => (
                    <li>
                      <span class={`sw-${item.swatch}`} aria-hidden="true" />
                      {item.label}
                    </li>
                  ))}
                </ul>
              </>
            )
          }
          <hr />
          <h2>Licence</h2>
          <p class="free">
            {
              indicator.access === 'Open-source'
                ? 'Free to use. The source code is on the script page.'
                : 'Free to use. The source code is protected.'
            }
          </p>
        </div>
      </aside>
    </div>
  </div>

  <section class="more-tools" aria-labelledby="other-tools">
    <div class="wrap">
      <h2 id="other-tools">Other tools</h2>
      <div class="mini-grid">
        {
          others.map((t) => (
            <a class="mini" href={`/tools/${t.slug}`}>
              <span class="cat">{t.category}</span>
              <h3>{t.name}</h3>
              <p>{t.summary}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
