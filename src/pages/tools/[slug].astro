---
import Layout from '../../layouts/Layout.astro';
import ExternalLink from '../../components/ExternalLink.astro';
import { indicators, TV_PROFILE } from '../../data/indicators';

export function getStaticPaths() {
  return indicators.map((indicator) => ({ params: { slug: indicator.slug }, props: { indicator } }));
}

const { indicator } = Astro.props;
const others = indicators.filter((t) => t.slug !== indicator.slug).slice(0, 3);
// Keep a trailing "[Itto-Ryu]" tag on one line.
const [, tvName, tvTag = ''] = indicator.tvTitle.match(/^(.*?)(\[[^\]]+\])?$/) ?? [, indicator.tvTitle];
const tended = new Date(indicator.tended).toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
});
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const lineShare = `https://social-plugins.line.me/lineit/share?url=${encodeURIComponent(pageUrl)}`;
---

<Layout title={indicator.name} description={indicator.summary} image={indicator.image} bodyClass="p-tools">
  <div class="wrap">
    <div class="detail">
      <article>
        <a class="back" href="/tools">All tools</a>
        <div class="meta">
          <span class="cat">{indicator.category}</span>
          <span class="lic">{indicator.access}</span>
        </div>
        <h1>{indicator.name}</h1>
        <p class="lede">{indicator.summary}</p>
        <p class="byline">By Thiranat · Last tended <time datetime={indicator.tended}>{tended}</time></p>
        <ExternalLink class="btn btn-primary m-only" href={indicator.url} data-event="tv_click" data-tool={indicator.slug}
          >Open on TradingView</ExternalLink
        >

        <figure class="figure">
          <img
            src={indicator.image}
            width={indicator.imageWidth}
            height={indicator.imageHeight}
            alt={`${indicator.name} readings on an example TradingView chart (illustrative only)`}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <figcaption>Illustrative only, on past data, not a trade idea. Chart by TradingView.</figcaption>
        </figure>
        {
          indicator.legend && (
            <div class="draws">
              <h2>What it draws</h2>
              <ul class="legend">
                {indicator.legend.map((item) => (
                  <li>
                    <span class={`sw-${item.swatch}`} aria-hidden="true" />
                    {item.label}
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        <div class="cols">
          <section>
            <h2>How it works</h2>
            <p>{indicator.howItWorks}</p>
          </section>
          <section>
            <h2>How to use</h2>
            <p>{indicator.howToUse}</p>
          </section>
        </div>

        <section class="not-do" aria-labelledby="not-do">
          <h2 id="not-do">What it does not do</h2>
          <ul class="dash">{indicator.notDo.map((line) => <li>{line}</li>)}</ul>
        </section>

        <section class="guide" aria-labelledby="settings">
          <h2 id="settings">Settings</h2>
          <table class="settings" aria-labelledby="settings">
            <thead>
              <tr><th scope="col">Setting</th><th scope="col">Default</th><th scope="col">What it changes</th></tr>
            </thead>
            <tbody>
              {
                indicator.settings.map((s) => (
                  <tr>
                    <th scope="row">{s.name}</th>
                    <td>{s.value}</td>
                    <td>{s.effect}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </section>

        <section class="guide" aria-labelledby="questions">
          <h2 id="questions">Questions worth asking</h2>
          <dl class="qa">
            {
              indicator.questions.map((item) => (
                <div>
                  <dt>{item.q}</dt>
                  <dd>{item.a}</dd>
                </div>
              ))
            }
          </dl>
        </section>

        <p class="care">
          Last tended <time datetime={indicator.tended}>{tended}</time> · Something unclear?{' '}
          <ExternalLink class="text-link" href={indicator.url} data-event="tv_click" data-tool={indicator.slug}
            >Ask in the comments on TradingView</ExternalLink
          > · For education only. Not investment advice.
        </p>
      </article>

      <aside class="aside" aria-label="On TradingView">
        <div class="aside-card">
          <ExternalLink class="btn btn-primary" href={indicator.url} data-event="tv_click" data-tool={indicator.slug}
            >Open on TradingView</ExternalLink
          >
          <p class="listed">
            Listed on TradingView as “{tvName}<span class="nowrap">{tvTag}</span>”. {
              indicator.access === 'Open-source'
                ? 'Free to use. The source code is on the script page.'
                : 'Free to use. The source code is protected.'
            }
          </p>
          <hr />
          <h2>Talk about it on TradingView</h2>
          <p>Questions, or something you noticed while using it?</p>
          <p class="go">
            <ExternalLink class="text-link" href={indicator.url} data-event="tv_click" data-tool={indicator.slug}
              >Comments are below the description on TradingView</ExternalLink
            >
          </p>
          <p class="quiet">I read the comments and reply when I can.</p>
          <p class="quiet">Share what you noticed, not what to buy. No calls, levels, P&amp;L or contact links.</p>
          <hr />
          <p>Follow on TradingView to be notified when a new tool or tutorial is published.</p>
          <p class="go">
            <ExternalLink class="text-link" href={TV_PROFILE} data-event="follow_click" data-page={Astro.url.pathname}
              >Follow Thiranat</ExternalLink
            >
          </p>
          <p class="share">
            Share: <ExternalLink href={lineShare}>LINE</ExternalLink><span class="copy-wrap"
              >{' · '}<button type="button" data-copy={pageUrl}>Copy link</button><span class="sr-only" role="status"></span></span
            >
          </p>
        </div>
      </aside>
    </div>
  </div>

  <section class="more-tools" aria-labelledby="other-tools">
    <div class="wrap">
      <h2 id="other-tools">Other tools</h2>
      <div class="mini-grid">
        {
          others.map((t) => (
            <a class="mini" href={`/tools/${t.slug}`}>
              <span class="cat">{t.category}</span>
              <h3>{t.name}</h3>
              <p>{t.summary}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>
  <script>
    // tv_click and follow_click reach Vercel Web Analytics once it is added to the site. Until then window.va
    // does not exist and this does nothing.
    for (const el of document.querySelectorAll<HTMLElement>('[data-event]')) {
      el.addEventListener('click', () => {
        const { event, ...data } = el.dataset;
        (window as { va?: (type: string, payload: object) => void }).va?.('event', { name: event, data });
      });
    }

    const copy = document.querySelector<HTMLButtonElement>('[data-copy]');
    const status = copy?.nextElementSibling;
    // In-app browsers (LINE among them) can block the Clipboard API, so fall back to a hidden textarea.
    const fallbackCopy = (text: string) => {
      const area = document.createElement('textarea');
      area.value = text;
      area.setAttribute('readonly', '');
      area.style.cssText = 'position:fixed;top:0;opacity:0';
      document.body.append(area);
      area.select();
      let ok = false;
      try {
        ok = document.execCommand('copy');
      } catch {}
      area.remove();
      return ok;
    };
    copy?.addEventListener('click', async () => {
      const url = copy.dataset.copy ?? location.href;
      let done = true;
      try {
        await navigator.clipboard.writeText(url);
      } catch {
        done = fallbackCopy(url);
      }
      copy.textContent = done ? 'Link copied' : 'Copy failed';
      if (status) status.textContent = copy.textContent;
      setTimeout(() => {
        copy.textContent = 'Copy link';
        if (status) status.textContent = '';
      }, 2000);
    });
  </script>
</Layout>

