---
import { langOf, t } from '../i18n';

interface Props {
  href: string;
  class?: string;
  [data: `data-${string}`]: string;
}

const { href, class: className, ...rest } = Astro.props;
const newTab = t(langOf(Astro.url.pathname)).site.newTab;
---

<a href={href} target="_blank" rel="noopener" class={className} {...rest}><slot /> <span class="ext" aria-hidden="true">↗</span><span class="sr-only"> {newTab}</span></a>
