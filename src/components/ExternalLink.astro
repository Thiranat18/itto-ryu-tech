---
interface Props {
  href: string;
  class?: string;
  [data: `data-${string}`]: string;
}

const { href, class: className, ...rest } = Astro.props;
---

<a href={href} target="_blank" rel="noopener" class={className} {...rest}><slot /> <span class="ext" aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
