---
import type { Indicator } from '../data/indicators';

interface Props {
  indicator: Indicator;
}

const { indicator } = Astro.props;
const Tag = indicator.url ? 'a' : 'div';
---

<Tag
  href={indicator.url ?? undefined}
  target={indicator.url ? '_blank' : undefined}
  rel={indicator.url ? 'noopener' : undefined}
  class="group relative flex flex-col overflow-hidden rounded-sm border border-line bg-gradient-to-br from-ink-2 to-ink p-6 transition-colors hover:border-shu/70"
>
  <span aria-hidden="true" class="absolute -right-3 -bottom-8 font-brush text-9xl text-paper/[0.04] transition-colors group-hover:text-shu/10">{indicator.kanji}</span>
  <span aria-hidden="true" class="absolute left-0 top-0 h-full w-[3px] bg-shu/60 transition-all group-hover:w-[5px] group-hover:bg-shu"></span>
  <p class="relative text-xs tracking-[0.2em] uppercase text-gold/90">{indicator.category}</p>
  <h3 class="relative mt-3 font-serif text-2xl font-semibold transition-colors group-hover:text-shu">{indicator.name}</h3>
  <p class="relative mt-3 text-sm leading-relaxed text-paper/80 flex-1">{indicator.summary}</p>
  <div class="relative mt-5 flex flex-wrap items-center gap-2">
    {indicator.tags.map((t) => <span class="rounded-full border border-line px-2.5 py-0.5 text-xs text-muted">{t}</span>)}
    <span class="ml-auto text-sm text-muted group-hover:text-paper">
      {indicator.url ? 'Open on TradingView →' : 'Link coming'}
    </span>
  </div>
</Tag>
