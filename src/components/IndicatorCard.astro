---
import type { Indicator } from '../data/indicators';

interface Props {
  indicator: Indicator;
}

const { indicator } = Astro.props;
---

<a
  href={`/tools/${indicator.slug}`}
  class="group flex flex-col rounded-md bg-kinu p-6 transition-colors hover:bg-byakuroku/60"
>
  <p class="text-[11px] tracking-[0.2em] uppercase text-usu">{indicator.category}</p>
  <h3 class="mt-2 font-serif text-xl font-medium">{indicator.name}</h3>
  <p class="mt-2 text-sm leading-relaxed text-usu flex-1">{indicator.summary}</p>
  <span class="mt-5 text-sm text-koke group-hover:text-matsuba">View tool →</span>
</a>
