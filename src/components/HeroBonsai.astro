---
import { FULL_MARK } from './marks';

// One word per foliage pad: kanji with its romaji reading (romaji hidden on phones).
// Decorative: the same words are spelled out in the "Ways" section below the hero.
const pads = [
  { kanji: '育', romaji: 'sodateru', x: 51, y: 23.6 },
  { kanji: '切', romaji: 'kiru', x: 25.8, y: 52.4 },
  { kanji: '待', romaji: 'matsu', x: 75, y: 42.2 },
];
---

<svg viewBox="0 0 100 100" aria-hidden="true">
  <g set:html={FULL_MARK} />
  <g fill="#FAF8F3" text-anchor="middle">
    {
      pads.map((p) => (
        <>
          <text x={p.x} y={p.y + 2} lang="ja" font-size="7.6" class="pad-m">{p.kanji}</text>
          <text x={p.x} y={p.y} lang="ja" font-size="7.2" class="pad-d">{p.kanji}</text>
          <text x={p.x} y={p.y + 4.8} font-size="2.7" letter-spacing="0.25" class="pad-d pad-r">{p.romaji}</text>
        </>
      ))
    }
  </g>
</svg>
