---
import { FULL_MARK } from './marks';
import { PAD_GLYPHS } from './padGlyphs';

// One word per foliage pad, 育 sodateru · 切 kiru · 待 matsu (romaji hidden on phones).
// Decorative: the same words are spelled out in the "Ways" section below the hero.
---

<svg viewBox="0 0 100 100" aria-hidden="true" focusable="false">
  <g set:html={FULL_MARK} />
  <g fill="#FAF8F3">
    {
      PAD_GLYPHS.map((p) => (
        <>
          <path class="pad-m" d={p.mobile} />
          <path class="pad-d" d={p.desktop} />
          <path class="pad-d" d={p.reading} />
        </>
      ))
    }
  </g>
</svg>
