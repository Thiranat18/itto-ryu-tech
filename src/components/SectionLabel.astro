---
interface Props {
  ja: string;
  title: string;
  subtitle?: string;
}

const { ja, title, subtitle } = Astro.props;
---

<div>
  <div class="flex items-center gap-3">
    <span class="font-brush text-shu text-lg tracking-[0.3em]">{ja}</span>
    <span class="h-px flex-1 bg-gradient-to-r from-line to-transparent"></span>
  </div>
  <h2 class="mt-3 font-serif text-3xl sm:text-4xl font-bold">{title}</h2>
  {subtitle && <p class="mt-2 text-muted">{subtitle}</p>}
</div>
