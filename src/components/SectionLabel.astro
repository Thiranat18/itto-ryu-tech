---
interface Props {
  label: string;
  title: string;
  subtitle?: string;
}

const { label, title, subtitle } = Astro.props;
---

<div>
  <p class="text-[11px] tracking-[0.25em] uppercase text-koke font-medium">{label}</p>
  <h2 class="mt-3 font-serif text-3xl sm:text-4xl font-medium">{title}</h2>
  {subtitle && <p class="mt-3 text-usu max-w-2xl leading-relaxed">{subtitle}</p>}
</div>
