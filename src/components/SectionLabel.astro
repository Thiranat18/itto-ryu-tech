---
interface Props {
  label: string;
  title?: string;
  subtitle?: string;
  level?: 1 | 2;
}

const { label, title, subtitle, level = 2 } = Astro.props;
const Tag = level === 1 ? 'h1' : 'h2';
---

<div>
  <p class="text-[11px] tracking-[0.25em] uppercase text-koke font-medium">{label}</p>
  {title && <Tag class="mt-3 font-serif text-3xl sm:text-4xl font-medium">{title}</Tag>}
  {subtitle && <p class="mt-3 text-usu max-w-2xl leading-relaxed">{subtitle}</p>}
</div>
