---
import type { Lesson } from '../data/lessons';

interface Props {
  lesson: Lesson;
  index: number;
}

const { lesson, index } = Astro.props;
---

<a
  href={`/lessons/${lesson.slug}`}
  class="group relative block overflow-hidden rounded-sm border border-line bg-gradient-to-br from-ink-2 to-ink p-6 transition-colors hover:border-shu/70"
>
  <span aria-hidden="true" class="absolute -right-2 -bottom-6 font-brush text-8xl text-paper/[0.04] transition-colors group-hover:text-shu/10">{lesson.rankJa}</span>
  <span aria-hidden="true" class="absolute left-0 top-0 h-full w-[3px] bg-shu/60 transition-all group-hover:w-[5px] group-hover:bg-shu"></span>
  <div class="relative flex items-center justify-between text-xs text-muted">
    <span class="tracking-widest">第{index + 1}章 · {lesson.rank}</span>
    {lesson.status === 'draft' && <span class="rounded-full border border-line px-2 py-0.5">กำลังเขียน</span>}
  </div>
  <h3 class="relative mt-4 font-serif text-2xl font-semibold transition-colors group-hover:text-shu">{lesson.title}</h3>
  <p class="relative mt-1 text-sm text-gold/90">{lesson.titleEn} · {lesson.indicator}</p>
  <p class="relative mt-4 text-sm leading-relaxed text-paper/85">{lesson.summary}</p>
</a>
