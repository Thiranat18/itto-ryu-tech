---
// Thai sets no spaces between words, so a display line can break inside a phrase ("ไม่ได้ / ผล"). On Thai pages
// each space-separated phrase is kept together where it fits; English text passes through unchanged.
import { langOf } from '../i18n';

interface Props {
  text: string;
}

const { text } = Astro.props;
// The spaces around ๆ belong to the word it repeats ("ค่อย ๆ เลี้ยง"), so they are not phrase breaks.
// Inside a phrase the space before ๆ must not break either, or ๆ starts a line.
const phrases =
  langOf(Astro.url.pathname) === 'th' ? text.split(/(?<!ๆ) (?!ๆ)/).map((p) => p.replace(/ ๆ/g, '\u00a0ๆ')) : null;
---

{phrases ? phrases.map((p, i) => <>{i > 0 && ' '}<span class="ph">{p}</span></>) : text}
