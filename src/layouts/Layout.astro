---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import ExternalLink from '../components/ExternalLink.astro';
import { OWNER, OWNER_DISPLAY } from '../data/owner';
import { TV_PROFILE } from '../data/indicators';
import { LANGS, fill, langOf, localize, pageIn, t } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  bodyClass?: string;
  /** False on pages that exist in one language only, such as the 404 page. */
  translated?: boolean;
}

const site = 'ITTO RYU TECH';
const path = Astro.url.pathname;
const lang = langOf(path);
const ui = t(lang);
const { title, description = ui.site.description, image = '/og.png', bodyClass, translated = true } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site,
  url: new URL('/', Astro.site).href,
  author: {
    '@type': 'Person',
    honorificPrefix: OWNER.honorific,
    name: OWNER.name,
    jobTitle: OWNER.role,
    url: new URL('/about/', Astro.site).href,
    sameAs: [TV_PROFILE, OWNER.github],
  },
};
const pageTitle = title ? `${title} · ${site}` : site;
const home = localize(lang, '/');

const nav = [
  { href: localize(lang, '/tools'), label: ui.site.tools },
  { href: localize(lang, '/about'), label: ui.site.about },
];
// Each language is named in its own words: "EN" and "ไทย".
const langLinks = LANGS.map((code) => ({
  code,
  href: pageIn(code, path),
  name: t(code).site.langName,
  readIn: t(code).site.readIn,
}));
const alternates = translated ? langLinks.map((l) => ({ code: l.code, href: new URL(l.href, Astro.site) })) : [];
// 'page' on the section's own page, 'true' on pages inside it (e.g. a tool's detail page).
const current = (href: string) =>
  path === href || path === `${href}/` ? 'page' : path.startsWith(`${href}/`) ? 'true' : undefined;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={OWNER_DISPLAY} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.code} href={a.href} />)}
    {alternates[0] && <link rel="alternate" hreflang="x-default" href={alternates[0].href} />}
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'th' ? 'th_TH' : 'en_GB'} />
    <meta property="og:site_name" content={site} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <meta name="theme-color" content="#FAF8F3" />
    <link rel="preload" href="/fonts/shippori-mincho-500.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class={bodyClass}>
    <div class="frame">
      <!-- The scroll rail: a vertical bar on wide screens, a top bar under 901px. -->
      <header class="rail">
        <a class="rail-home" href={home} aria-label={ui.site.homeLabel}>
          <Logo size={40} stroke={2} />
          <span class="rail-kanji" lang="ja">一刀流</span>
          <span class="rail-word">{site}</span>
        </a>
        <div class="rail-end">
          <nav class="rail-nav" aria-label={ui.site.mainNav}>
            {nav.map((item) => <a href={item.href} aria-current={current(item.href)}>{item.label}</a>)}
            <ExternalLink href={TV_PROFILE}>TradingView</ExternalLink>
          </nav>
          {
            translated && (
              <ul class="lang-switch" role="list" aria-label={ui.site.language}>
                {langLinks.map((l) => (
                  <li class={l.code === lang ? 'here' : undefined}>
                    <a
                      href={l.href}
                      hreflang={l.code}
                      lang={l.code}
                      aria-current={l.code === lang ? 'true' : undefined}
                      data-lang-switch
                    >
                      {l.name}{l.code !== lang && <span class="sr-only"> {l.readIn}</span>}
                    </a>
                  </li>
                ))}
              </ul>
            )
          }
          <button class="menu" type="button" aria-expanded="false" aria-controls="menu-panel">{ui.site.menu}</button>
          <div class="hanko" aria-hidden="true"><span lang="ja">一刀</span></div>
        </div>
        <nav id="menu-panel" class="menu-panel" aria-label={ui.site.mainNav} hidden>
          <ul>
            {nav.map((item) => <li><a href={item.href} aria-current={current(item.href)}>{item.label}</a></li>)}
            <li><ExternalLink href={TV_PROFILE}>TradingView</ExternalLink></li>
          </ul>
        </nav>
      </header>

      <!-- The tatami grid: pages put their tiles straight into it; main uses display:contents so the footer tile
           shares the grid while staying a contentinfo landmark outside main. -->
      <div class="grid">
        <main class="grid-main">
          <slot />
        </main>
        <footer class="tile tile-ink foot">
          <div class="foot-sign">
            <p class="motto" set:html={ui.site.mottoHtml} />
            <img class="foot-kiko" src="/kiko-light.svg" width="74" height="124" loading="lazy" alt="" aria-hidden="true" />
          </div>
          <div class="legal">
            <p class="first">{ui.site.footEdu}</p>
            <p set:html={ui.site.footAffiliationHtml} />
            <p>{fill(ui.site.footOwned, { owner: OWNER_DISPLAY, role: ui.site.ownerRole })}</p>
            <p class="foot-faint">{ui.site.footLicences}</p>
          </div>
        </footer>
      </div>
    </div>

    <script is:inline>
      (() => {
        const button = document.querySelector('.menu');
        const panel = document.getElementById('menu-panel');
        if (!button || !panel) return;
        const set = (open) => {
          button.setAttribute('aria-expanded', String(open));
          panel.hidden = !open;
        };
        button.addEventListener('click', () => set(button.getAttribute('aria-expanded') !== 'true'));
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && !panel.hidden) {
            set(false);
            button.focus();
          }
        });
        matchMedia('(min-width: 901px)').addEventListener('change', (e) => e.matches && set(false));
      })();
      // Switching language keeps the place on the page and any /tools filter.
      for (const a of document.querySelectorAll('[data-lang-switch]')) {
        a.addEventListener('click', () => {
          a.href = a.pathname + location.search + location.hash;
        });
      }
    </script>
  </body>
</html>
