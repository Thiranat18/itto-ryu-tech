---
import '../styles/global.css';
import Lockup from '../components/Lockup.astro';
import { OWNER, OWNER_DISPLAY } from '../data/owner';
import { TV_PROFILE } from '../data/indicators';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const site = 'Itto-Ryu Tech';
const {
  title,
  description = 'Free Pine Script indicators for TradingView, most of them open-source. Grow with patience. Cut with discipline.',
  image = '/og.png',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site,
  url: new URL('/', Astro.site).href,
  author: {
    '@type': 'Person',
    honorificPrefix: OWNER.honorific,
    name: OWNER.name,
    jobTitle: OWNER.role,
    url: new URL('/about/', Astro.site).href,
    sameAs: [TV_PROFILE, OWNER.github],
  },
};
const pageTitle = title ? `${title} · ${site}` : site;
const path = Astro.url.pathname;

const nav = [
  { href: '/tools', label: 'Tools' },
  { href: '/about', label: 'About' },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={OWNER_DISPLAY} />
    <link rel="canonical" href={canonical} />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Itto-Ryu Tech" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <meta name="theme-color" content="#FAF8F3" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500&family=Shippori+Mincho:wght@500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="border-b border-line">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
        <a href="/" aria-label="Itto-Ryu Tech home" class="no-underline"><Lockup /></a>
        <nav class="flex items-center text-sm">
          {nav.map((item) => (
            <a
              href={item.href}
              aria-current={path.startsWith(item.href) ? 'page' : undefined}
              class="px-3 py-2 rounded text-usu hover:text-sumi aria-[current=page]:text-sumi aria-[current=page]:underline decoration-koke underline-offset-[6px]"
            >
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-line mt-24">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 py-12 grid gap-8 sm:grid-cols-[1fr_1.4fr]">
        <div>
          <p class="font-serif text-xl">Still mind. Clear rules.</p>
        </div>
        <div class="text-sm text-usu space-y-2 leading-relaxed">
          <p>
            For education only. Not investment advice.{' '}
            <a href="/disclaimer" class="underline hover:text-sumi">Disclaimer</a>
          </p>
          <p>Not affiliated with or endorsed by TradingView. Not affiliated with any Ittō-ryū school of swordsmanship.</p>
          <p>© 2026 Itto-Ryu Tech, owned and developed by {OWNER_DISPLAY}, {OWNER.role}.</p>
          <p>Website code MIT · Open-source indicators MPL 2.0 · Text CC BY 4.0 (logo and chart images excluded)</p>
        </div>
      </div>
    </footer>
  </body>
</html>
