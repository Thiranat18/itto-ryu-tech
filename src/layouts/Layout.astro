---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const site = 'Itto-ryu Tech Dojo';
const { title, description = 'สำนักฝึกเทรดแบบมีระบบและมีหลักฐาน สอนด้วย indicator open-source ของ Itto-ryu' } = Astro.props;
const pageTitle = title ? `${title} · ${site}` : site;
const path = Astro.url.pathname;

const nav = [
  { href: '/lessons', label: 'หลักสูตร' },
  { href: '/about', label: 'เกี่ยวกับสำนัก' },
];
---

<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@400;500;600&family=Noto+Serif+Thai:wght@600;700&family=Yuji+Syuku&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="sticky top-0 z-40 border-b border-line/70 bg-ink/80 backdrop-blur">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
        <a href="/" class="flex items-center gap-2.5 no-underline">
          <span class="grid place-items-center size-8 rounded-[3px] bg-shu text-ink font-brush text-xl leading-none shadow-[0_0_0_2px_#0b0a09,0_0_0_3px_#d6452f55]">一</span>
          <span class="font-serif font-semibold tracking-wide whitespace-nowrap">Itto-ryu <span class="hidden sm:inline text-muted font-normal">Tech Dojo</span></span>
        </a>
        <nav class="flex items-center text-sm whitespace-nowrap">
          {nav.map((item) => (
            <a
              href={item.href}
              class:list={[
                'px-2.5 sm:px-3 py-2 rounded-md hover:bg-ink-2',
                path.startsWith(item.href) ? 'text-paper' : 'text-muted',
              ]}
            >
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-line mt-20">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 py-8 text-sm text-muted space-y-3">
        <p>
          เนื้อหาทั้งหมดมีไว้เพื่อการศึกษา <strong class="text-paper font-medium">ไม่ใช่คำแนะนำการลงทุน</strong>
          <a href="/disclaimer" class="underline hover:text-paper ml-1">อ่านข้อจำกัดความรับผิดชอบ</a>
        </p>
        <p>
          โค้ด MIT · เนื้อหา CC BY 4.0 ·
          <a href="https://github.com/Thiranat18/itto-ryu-dojo" class="underline hover:text-paper">GitHub</a>
        </p>
      </div>
    </footer>
  </body>
</html>
