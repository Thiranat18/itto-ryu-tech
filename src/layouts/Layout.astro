---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import ExternalLink from '../components/ExternalLink.astro';
import { OWNER, OWNER_DISPLAY } from '../data/owner';
import { TV_PROFILE } from '../data/indicators';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  bodyClass?: string;
}

const site = 'Itto-Ryu Tech';
const {
  title,
  description = 'Free Pine Script indicators for TradingView, most of them open-source. Grow with patience. Cut with discipline.',
  image = '/og.png',
  bodyClass,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site,
  url: new URL('/', Astro.site).href,
  author: {
    '@type': 'Person',
    honorificPrefix: OWNER.honorific,
    name: OWNER.name,
    jobTitle: OWNER.role,
    url: new URL('/about/', Astro.site).href,
    sameAs: [TV_PROFILE, OWNER.github],
  },
};
const pageTitle = title ? `${title} · ${site}` : site;
const path = Astro.url.pathname;

const nav = [
  { href: '/tools', label: 'Tools' },
  { href: '/about', label: 'About' },
];
// 'page' on the section's own page, 'true' on pages inside it (e.g. a tool's detail page).
const current = (href: string) =>
  path === href || path === `${href}/` ? 'page' : path.startsWith(`${href}/`) ? 'true' : undefined;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={OWNER_DISPLAY} />
    <link rel="canonical" href={canonical} />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Itto-Ryu Tech" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <meta name="theme-color" content="#FAF8F3" />
    <link rel="preload" href="/fonts/shippori-mincho-500.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class={bodyClass}>
    <header class="nav">
      <div class="wrap nav-in">
        <a class="brand" href="/" aria-label="Itto-Ryu Tech home"><Logo /><span>ITTO-RYU</span><span class="tech">TECH</span></a>
        <nav class="nav-links" aria-label="Main">
          {nav.map((item) => <a href={item.href} aria-current={current(item.href)}>{item.label}</a>)}
          <ExternalLink class="btn btn-ghost btn-sm" href={TV_PROFILE}>TradingView</ExternalLink>
        </nav>
        <button class="menu" type="button" aria-expanded="false" aria-controls="menu-panel">Menu</button>
      </div>
      <nav id="menu-panel" class="menu-panel" aria-label="Main" hidden>
        <ul class="wrap">
          {nav.map((item) => <li><a href={item.href} aria-current={current(item.href)}>{item.label}</a></li>)}
          <li><ExternalLink href={TV_PROFILE}>TradingView</ExternalLink></li>
        </ul>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap foot-in">
        <div>
          <a class="brand" href="/" aria-label="Itto-Ryu Tech home"><Logo light /><span>ITTO-RYU</span><span class="tech">TECH</span></a>
          <p class="motto">Still mind.<br />Clear rules.</p>
          <nav class="foot-nav" aria-label="Footer">
            <a href="/tools">Tools</a>
            <a href="/about">About</a>
            <a href="/disclaimer">Disclaimer</a>
            <ExternalLink href={TV_PROFILE}>TradingView</ExternalLink>
          </nav>
        </div>
        <div class="legal">
          <p class="first">For education only. Not investment advice. Indicators describe market conditions; they do not predict prices.</p>
          <p>Not affiliated with or endorsed by TradingView. Not affiliated with any <span class="nowrap">Ittō-ryū</span> school of swordsmanship.</p>
          <p>© 2026 Itto-Ryu Tech, owned and developed by {OWNER_DISPLAY}, {OWNER.role}.</p>
        </div>
      </div>
      <div class="foot-mark" aria-hidden="true">
        <img class="foot-kiko" src="/kiko-light.svg" width="74" height="124" loading="lazy" alt="" />
        <div class="tate" lang="ja">明鏡止水</div>
      </div>
      <div class="wrap">
        <div class="foot-bottom">
          <span>Website code MIT · Open-source indicators MPL 2.0 · Text CC BY 4.0 (logo and chart images excluded)</span>
          <span>ittoryutech.com</span>
        </div>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const button = document.querySelector('.menu');
        const panel = document.getElementById('menu-panel');
        if (!button || !panel) return;
        const set = (open) => {
          button.setAttribute('aria-expanded', String(open));
          panel.hidden = !open;
        };
        button.addEventListener('click', () => set(button.getAttribute('aria-expanded') !== 'true'));
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && !panel.hidden) {
            set(false);
            button.focus();
          }
        });
        matchMedia('(min-width: 761px)').addEventListener('change', (e) => e.matches && set(false));
      })();
    </script>
  </body>
</html>
