---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import ExternalLink from '../components/ExternalLink.astro';
import { OWNER, OWNER_DISPLAY } from '../data/owner';
import { TV_PROFILE } from '../data/indicators';
import { LANGS, fill, langOf, localize, pageIn, t } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  bodyClass?: string;
  /** False on pages that exist in one language only, such as the 404 page. */
  translated?: boolean;
}

const site = 'Itto-Ryu Tech';
const path = Astro.url.pathname;
const lang = langOf(path);
const ui = t(lang);
const { title, description = ui.site.description, image = '/og.png', bodyClass, translated = true } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site,
  url: new URL('/', Astro.site).href,
  author: {
    '@type': 'Person',
    honorificPrefix: OWNER.honorific,
    name: OWNER.name,
    jobTitle: OWNER.role,
    url: new URL('/about/', Astro.site).href,
    sameAs: [TV_PROFILE, OWNER.github],
  },
};
const pageTitle = title ? `${title} · ${site}` : site;
const home = localize(lang, '/');

const nav = [
  { href: localize(lang, '/tools'), label: ui.site.tools },
  { href: localize(lang, '/about'), label: ui.site.about },
];
// Each language is named in its own words: "EN" and "ไทย".
const langLinks = LANGS.map((code) => ({
  code,
  href: pageIn(code, path),
  name: t(code).site.langName,
  readIn: t(code).site.readIn,
}));
const alternates = translated ? langLinks.map((l) => ({ code: l.code, href: new URL(l.href, Astro.site) })) : [];
// 'page' on the section's own page, 'true' on pages inside it (e.g. a tool's detail page).
const current = (href: string) =>
  path === href || path === `${href}/` ? 'page' : path.startsWith(`${href}/`) ? 'true' : undefined;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={OWNER_DISPLAY} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.code} href={a.href} />)}
    {alternates[0] && <link rel="alternate" hreflang="x-default" href={alternates[0].href} />}
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'th' ? 'th_TH' : 'en_GB'} />
    <meta property="og:site_name" content="Itto-Ryu Tech" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <meta name="theme-color" content="#FAF8F3" />
    <link rel="preload" href="/fonts/shippori-mincho-500.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class={bodyClass}>
    <header class="nav">
      <div class="wrap nav-in">
        <a class="brand" href={home} aria-label={ui.site.homeLabel}><Logo /><span>ITTO-RYU</span><span class="tech">TECH</span></a>
        <nav class="nav-links" aria-label={ui.site.mainNav}>
          {nav.map((item) => <a href={item.href} aria-current={current(item.href)}>{item.label}</a>)}
          <ExternalLink class="btn btn-ghost btn-sm" href={TV_PROFILE}>TradingView</ExternalLink>
        </nav>
        {
          translated && (
            <ul class="lang-switch" role="list" aria-label={ui.site.language}>
              {langLinks.map((l) => (
                <li class={l.code === lang ? 'here' : undefined}>
                  <a
                    href={l.href}
                    hreflang={l.code}
                    lang={l.code}
                    aria-current={l.code === lang ? 'true' : undefined}
                    aria-label={l.code === lang ? undefined : l.readIn}
                    data-lang-switch
                  >
                    {l.name}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
        <button class="menu" type="button" aria-expanded="false" aria-controls="menu-panel">{ui.site.menu}</button>
      </div>
      <nav id="menu-panel" class="menu-panel" aria-label={ui.site.mainNav} hidden>
        <ul class="wrap">
          {nav.map((item) => <li><a href={item.href} aria-current={current(item.href)}>{item.label}</a></li>)}
          <li><ExternalLink href={TV_PROFILE}>TradingView</ExternalLink></li>
        </ul>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap foot-in">
        <div class="foot-id">
          <a class="brand" href={home} aria-label={ui.site.homeLabel}><Logo light /><span>ITTO-RYU</span><span class="tech">TECH</span></a>
          <div class="foot-sign">
            <p class="motto" set:html={ui.site.mottoHtml} />
            <img class="foot-kiko" src="/kiko-light.svg" width="74" height="124" loading="lazy" alt="" aria-hidden="true" />
          </div>
        </div>
        <div class="legal">
          <p class="first">{ui.site.footEdu}</p>
          <p set:html={ui.site.footAffiliationHtml} />
          <p>{fill(ui.site.footOwned, { owner: OWNER_DISPLAY, role: ui.site.ownerRole })}</p>
        </div>
      </div>
      <div class="tate" lang="ja" aria-hidden="true">明鏡止水</div>
      <div class="wrap">
        <div class="foot-bottom">
          <span>{ui.site.footLicences}</span>
          <span>ittoryutech.com</span>
        </div>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const button = document.querySelector('.menu');
        const panel = document.getElementById('menu-panel');
        if (!button || !panel) return;
        const set = (open) => {
          button.setAttribute('aria-expanded', String(open));
          panel.hidden = !open;
        };
        button.addEventListener('click', () => set(button.getAttribute('aria-expanded') !== 'true'));
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && !panel.hidden) {
            set(false);
            button.focus();
          }
        });
        matchMedia('(min-width: 761px)').addEventListener('change', (e) => e.matches && set(false));
      })();
      // Switching language keeps the place on the page and any /tools filter.
      for (const a of document.querySelectorAll('[data-lang-switch]')) {
        a.addEventListener('click', () => {
          a.href = a.pathname + location.search + location.hash;
        });
      }
    </script>
  </body>
</html>
