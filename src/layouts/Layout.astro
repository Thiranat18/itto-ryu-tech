---
import '../styles/global.css';
import Lockup from '../components/Lockup.astro';

interface Props {
  title?: string;
  description?: string;
}

const site = 'Itto-Ryu Tech';
const { title, description = 'Open-source Pine Script indicators for TradingView. Grow with patience. Cut with discipline.' } = Astro.props;
const pageTitle = title ? `${title} · ${site}` : site;
const path = Astro.url.pathname;

const nav = [
  { href: '/tools', label: 'Tools' },
  { href: '/about', label: 'About' },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#FAF8F3" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400&family=IBM+Plex+Sans:wght@400;500&family=IBM+Plex+Sans+Thai+Looped:wght@400;500&family=Shippori+Mincho:wght@500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="border-b border-line">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
        <a href="/" aria-label="Itto-Ryu Tech home" class="no-underline"><Lockup /></a>
        <nav class="flex items-center text-sm">
          {nav.map((item) => (
            <a
              href={item.href}
              class:list={[
                'px-3 py-2 rounded hover:text-sumi',
                path.startsWith(item.href) ? 'text-sumi' : 'text-usu',
              ]}
            >
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-line mt-24">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 py-12 grid gap-8 sm:grid-cols-[1fr_1.4fr]">
        <div>
          <p class="font-serif text-xl">Still mind. Clear rules.</p>
          <p lang="th" class="text-usu">ใจนิ่ง กฎชัด</p>
        </div>
        <div class="text-sm text-usu space-y-2 leading-relaxed">
          <p>
            For education only. Not investment advice.{' '}
            <a href="/disclaimer" class="underline hover:text-sumi">Disclaimer</a>
          </p>
          <p>Not affiliated with or endorsed by TradingView, or with any Ittō-ryū school of swordsmanship.</p>
          <p>Code MIT · Content CC BY 4.0</p>
        </div>
      </div>
    </footer>
  </body>
</html>
